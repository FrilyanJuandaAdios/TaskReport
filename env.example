# Copy this file to `.env` (or `.env.local`) before running the app:
#   cp env.example .env
#
# ---------------------------------------------------------------------------
# Storage driver
# ---------------------------------------------------------------------------
# "local"    -> IndexedDB (Dexie). Zero setup, offline-first. DEFAULT.
# "supabase" -> Postgres via Supabase. Requires the two vars below + migration.
VITE_DB_DRIVER=local

# ---------------------------------------------------------------------------
# Supabase (only needed when VITE_DB_DRIVER=supabase)
# Project settings -> API. The anon key is safe in the browser *only* with RLS on.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Notion integration (optional, Phase 2)
# "mock"  -> no network, returns the payload + markdown so you can paste it. DEFAULT.
# "proxy" -> POSTs to VITE_NOTION_PROXY_URL (a serverless fn that holds the secret).
# Never put a Notion integration token in a VITE_ var: it ships to the browser.
# ---------------------------------------------------------------------------
VITE_NOTION_DRIVER=mock
VITE_NOTION_PROXY_URL=
VITE_NOTION_REPORTS_DATABASE_ID=
VITE_NOTION_DELIVERIES_DATABASE_ID=
